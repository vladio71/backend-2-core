# ---------- Основне ----------
# development | test | production. У development доступний /demo/sql-injection і відкритий /queues.
NODE_ENV=development
# Порт HTTP-сервера API.
PORT=3000
# Ім'я інстансу у логах і у відповідях (api-1, api-2). Корисно, коли два API за nginx.
INSTANCE_NAME=api-1

# ---------- Обов'язкові (без них застосунок не стартує) ----------
# Рядок підключення до PostgreSQL.
DATABASE_URL=postgres://devhub:devhub@localhost:5432/devhub
# Секрет для підпису JWT. Мінімум 16 символів. Згенеруй: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Пул з'єднань до Postgres ----------
# Скільки з'єднань тримає один процес. Postgres має max_connections (типово 100).
# Усі процеси разом (api-1 + api-2 + worker) не мають перевищувати його. Малий max навмисно: /demo/pool/slow.
DB_POOL_MAX=10
# Скільки чекати на вільне з'єднання, перш ніж кинути помилку.
DB_ACQUIRE_TIMEOUT_MS=10000
# true = друкувати кожен SQL-запит у логи (тільки для навчання, у production шумно).
DB_LOG_QUERIES=false

# ---------- Auth ----------
# Час життя access-токена в секундах (15 хв).
JWT_ACCESS_TTL_SECONDS=900
# Час життя refresh-токена в днях.
REFRESH_TTL_DAYS=30
# Вартість bcrypt (2^N раундів). 10 = ~50-100 мс на хеш. 12 для production з запасом.
BCRYPT_COST=10

# ---------- CORS ----------
# Список origin-ів через кому, звідки браузеру можна ходити в API.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- Rate limit (власний token bucket) ----------
# 10 запитів за 10 секунд на користувача для POST /posts.
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_WINDOW_SECONDS=10

# ---------- Черги ----------
# Backpressure: якщо у черзі reports чекає більше job-ів, POST /reports відповідає 429 QUEUE_FULL.
QUEUE_MAX_WAITING=100
# Скільки звітів воркер робить одночасно.
WORKER_CONCURRENCY=2
# Тривалість одного з 5 кроків звіту у мс (1000 = звіт триває 5 с).
REPORT_STEP_MS=1000

# ---------- GitHub ----------
# Без токена: 60 запитів/год. З токеном (classic або fine-grained, без прав): 5000/год.
GITHUB_TOKEN=
# У тестах підміняється на локальний mock-сервер.
GITHUB_API_URL=https://api.github.com

# ---------- LLM / ембединги ----------
# Порожньо = FakeLlmProvider і FakeEmbeddingProvider (детерміновані, без мережі).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------- Трейсинг (OpenTelemetry -> Jaeger) ----------
# Порожньо = трейсинг вимкнено (тести, dev без Jaeger). У docker compose = http://jaeger:4318.
# Локально з Jaeger у Docker: http://localhost:4318. Див. docs/tracing.md.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Ім'я сервісу в Jaeger. Порожньо = INSTANCE_NAME (api-1, worker).
OTEL_SERVICE_NAME=

# ---------- Інше ----------
# PGVECTOR=1 вмикає e2e-тест similar-пошуку (потрібен образ pgvector/pgvector:pg16).
PGVECTOR=
# true = Bull Board (/queues) відкритий без JWT навіть поза development.
BULL_BOARD_OPEN=
