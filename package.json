{
  "name": "devhub-core",
  "version": "1.0.0",
  "private": true,
  "description": "devhub: навчальний backend на NestJS 11, PostgreSQL 16 і Redis 7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "up": "node scripts/up.mjs",
    "down": "node scripts/down.mjs",
    "setup": "npm install && npm install --prefix learn",
    "postinstall": "node scripts/postinstall.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "graph": "depcruise src --config .dependency-cruiser.cjs --output-type archi --include-only \"^src\" | dot -Tsvg -o docs/graphs/modules.svg",
    "graph:files": "depcruise src --config .dependency-cruiser.cjs --output-type dot --include-only \"^src\" | dot -Tsvg -o docs/graphs/files.svg",
    "docs:code": "compodoc -p tsconfig.build.json -d docs/compodoc -n \"devhub-core\" --disableCoverage --disableDomTree --disableTemplateTab --disableStyleTab",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "migration:generate": "tsx --env-file-if-exists=.env node_modules/typeorm/cli.js -d src/data-source.ts migration:generate",
    "migration:run": "tsx --env-file-if-exists=.env node_modules/typeorm/cli.js -d src/data-source.ts migration:run",
    "migration:revert": "tsx --env-file-if-exists=.env node_modules/typeorm/cli.js -d src/data-source.ts migration:revert",
    "migration:show": "tsx --env-file-if-exists=.env node_modules/typeorm/cli.js -d src/data-source.ts migration:show",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "bench:batch": "tsx --env-file-if-exists=.env scripts/bench-batch.ts",
    "test": "jest -c jest.config.js",
    "test:int": "node --env-file-if-exists=.env.test node_modules/jest/bin/jest.js -c jest.int.config.js --runInBand",
    "test:e2e": "node --env-file-if-exists=.env.test node_modules/jest/bin/jest.js -c jest.e2e.config.js --runInBand",
    "test:all": "npm run test && npm run test:int && npm run test:e2e",
    "test:migrate": "tsx --env-file-if-exists=.env.test node_modules/typeorm/cli.js -d src/data-source.ts migration:run"
  },
  "dependencies": {
    "@bull-board/api": "9.10.5",
    "@bull-board/express": "9.10.5",
    "@bull-board/nestjs": "9.10.5",
    "@nestjs/bull-shared": "11.0.5",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/platform-socket.io": "11.2.8",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "11.0.3",
    "@nestjs/websockets": "11.2.8",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.81.2",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@scalar/nestjs-api-reference": "1.2.33",
    "@socket.io/redis-adapter": "8.3.0",
    "bcryptjs": "3.0.3",
    "bullmq": "5.81.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "typeorm": "0.3.31",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@compodoc/compodoc": "2.0.0",
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "11.2.8",
    "@types/bcryptjs": "3.0.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "globals": "^15.15.0",
    "jest": "30.5.2",
    "socket.io-client": "4.8.3",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
